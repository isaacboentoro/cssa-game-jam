config_version=5

[application]

config/name="CSSA Game Jam"
run/main_scene="uid://l5ao6xue3ul0"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/size/viewport_width=400

[autoload]

Blackjack="*uid://cjglii7apywf"
PlayerStats="*res://scripts/player_stats.gd"

[debug]

settings/stdout/print_gpu_profile=true

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

